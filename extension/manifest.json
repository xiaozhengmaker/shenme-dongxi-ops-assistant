{
  "manifest_version": 3,
  "name": "社么东西 · 社群运营助手",
  "version": "1.1.0",
  "description": "本地优先的社群运营助手：用你自己的登录会话，在 Facebook / Telegram 搜索并加入相关群组，结果写入飞书多维表格。",
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "alarms",
    "downloads",
    "sidePanel"
  ],
  "host_permissions": [
    "https://web.telegram.org/*",
    "https://www.facebook.com/*",
    "https://m.facebook.com/*",
    "https://web.whatsapp.com/*",
    "https://discord.com/*",
    "https://www.reddit.com/*",
    "https://steamcommunity.com/*",
    "http://127.0.0.1:8787/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "action": {
    "default_title": "社么东西 · 社群运营助手"
  },
  "options_page": "src/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:8787/*"
      ],
      "js": [
        "src/content_bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}