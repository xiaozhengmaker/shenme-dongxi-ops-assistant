# Optional server-side model provider. Leave this file absent to run search-only
# with provider_not_configured; never put secrets in the browser or in logs.
# Copy to .env and fill locally if the host already has an authorized key.
# LEADS_WATER_PROVIDER=deepseek
# LEADS_WATER_API_KEY=
# LEADS_WATER_BASE_URL=https://api.deepseek.com
# LEADS_WATER_MODEL=deepseek-chat

# Real public search is enabled by start-research.ps1; do not set provider=fixture
# in production because it would make model output look like real conclusions.
